{
	quest.01D3ED8EDE07740B.quest_desc: [
		"The &6Pinnacle&r is the highest World Tier."
		""
		"Equip a complete set of &5Epic&r Affix Gear:"
		""
		"&5Epic Helmet"
		"&5Epic Chestplate"
		"&5Epic Leggings"
		"&5Epic Boots"
		"&5Epic Weapon"
		""
		"Then defeat the &cEnder Dragon&r."
		""
		"Complete both requirements to reach the &6Pinnacle&r."
	]
	quest.01D3ED8EDE07740B.quest_subtitle: "The final World Tier awaits."
	quest.01D3ED8EDE07740B.title: "&z&lPinnacle"
	quest.07428CAC35BEA69B.quest_desc: [
		"The &5Reforging Table&r provides a more powerful way to reshape your Affix Gear."
		""
		"Place an Affix Item inside to replace its current Affixes with a new combination."
		""
		"Reforging uses &6Rarity Materials&r and reforging resources."
		""
		"Use it when an item's rarity and potential are worth keeping, but its Affixes aren't."
	]
	quest.07428CAC35BEA69B.quest_subtitle: "Good gear can still have bad Affixes."
	quest.07428CAC35BEA69B.title: "&dReforge Your Gear"
	quest.10BD26FC074B3066.quest_desc: [
		"The ultimate evolution of the &bEnchantment Library&r."
		""
		"The &zLibrary of Alexandria&r greatly expands your ability to store enchantments, making it easier to build and maintain a collection of powerful enchanted books."
		""
		"Store your accumulated enchantment knowledge here and retrieve it whenever you need it, instead of keeping piles of enchanted books in storage."
		""
		"This is the final step in building a dedicated enchantment library."
		""
		"Tip: Combine this with the &eTome of Extraction&r to safely move powerful enchantments from existing gear into your collection."
	]
	quest.10BD26FC074B3066.quest_subtitle: "Master the Art of Enchanting"
	quest.14DDF01D6F7D46A7.quest_desc: [
		"&bThe Enchanting Table of the Raven&r allows direct customization of the core enchanting stats. "
		""
		"Use it when you want &eprecise control&r over your enchanting setup."
	]
	quest.14DDF01D6F7D46A7.quest_subtitle: "Manual stat control"
	quest.14DDF01D6F7D46A7.title: "The Raven Knows"
	quest.162DAA9CC7C05079.quest_desc: [
		"Not every Affix Item comes with the Affixes you want."
		""
		"The &5Simple Reforging Table&r lets you reforge equipment and replace its current Affixes with a new combination."
		""
		"It's a simple way to improve promising gear without needing the full reforging setup."
		""
		"Craft a &5Simple Reforging Table&r and try your luck."
	]
	quest.162DAA9CC7C05079.quest_subtitle: "Sometimes a little luck is all you need."
	quest.162DAA9CC7C05079.title: "Simple Reforging"
	quest.1CD3AD0FB5604882.quest_desc: ["Craft the &bApothic Enchanting Table&r and begin using &2Eterna&r, &4Quanta&r and &5Arcana&r to push enchanting beyond vanilla limits, with progression reaching level 100."]
	quest.1CD3AD0FB5604882.quest_subtitle: "Begin the overhaul"
	quest.1CD3AD0FB5604882.title: "The Secrets of Enchanting"
	quest.1D9FEC69371DC538.quest_desc: [
		"Found the perfect Affix Gear, but it doesn't have enough &bSockets&r?"
		""
		"A &bSigil of Socketing&r can add another socket to compatible Affix Gear."
		""
		"Use one to make room for another Gem."
	]
	quest.1D9FEC69371DC538.quest_subtitle: "The right gear deserves more sockets."
	quest.1D9FEC69371DC538.title: "More Room"
	quest.21474801C1472EF7.quest_desc: [
		"A &bTome of Scrapping&r lets you remove enchantments from an item and recover them as enchanted books."
		""
		"The process is lossy - only half of the item's enchantments are recovered, and the original item is destroyed."
		""
		"For a complete extraction without destroying the item, use a Tome of Extraction instead."
		""
		"Tip: Use the &bTome of Superior Scrapping&r if you want to recover all of the enchantments but don't mind sacrificing the item."
	]
	quest.21474801C1472EF7.quest_subtitle: "Salvage Enchantments"
	quest.282C623AA0870088.quest_desc: [
		"The &bGem Cutting Table&r allows you to improve your Gems."
		""
		"It uses &bGem Dust&r and &6Rarity Materials&r to increase a Gem's power."
		""
		"Craft a &bGem Cutting Table&r and start refining your Gems."
	]
	quest.282C623AA0870088.quest_subtitle: "Better Gems require better tools."
	quest.282C623AA0870088.title: "Cut to Size"
	quest.2936EE38CEAB4337.quest_desc: ["&bWeapon&r and &bBow Tomes&r focus on combat-related enchantments and help keep your specialized enchantment collections organized."]
	quest.2936EE38CEAB4337.quest_subtitle: "Target combat enchantments"
	quest.2936EE38CEAB4337.title: "Tomes of Combat"
	quest.2943A8844EAD8107.quest_desc: [
		"Not all equipment is created equal."
		""
		"Some weapons and armor can be found with"
		"powerful &dAffixes&r attached to them."
		""
		"These Affixes can grant everything from"
		"increased damage and durability to entirely"
		"new abilities."
		""
		"Find your first piece of &dAffix Gear&r and"
		"begin your journey into Apotheosis."
	]
	quest.2943A8844EAD8107.quest_subtitle: "There is more to your gear than meets the eye."
	quest.2943A8844EAD8107.title: "&5A New Power"
	quest.382C37A47810F0CF.quest_desc: [
		"Affix Gear comes in five rarities:"
		""
		"&7Common&r — Basic equipment with few special stats."
		"&aUncommon&r — More Affixes and occasional Gem Sockets."
		"&9Rare&r — Multiple Affixes with Sockets becoming more common."
		"&5Epic&r — Powerful effect Affixes and multiple Gem Sockets."
		"&6Mythic&r — Maximum Affixes and the strongest stats."
		""
		"To reach the &6Frontier&r, equip a complete set of &7Common&r Affix Gear:"
		""
		"&7Common Helmet"
		"&7Common Chestplate"
		"&7Common Leggings"
		"&7Common Boots"
		"&7Common Weapon"
		""
		"Use &fCtrl + T&r to manage your World Tier."
	]
	quest.382C37A47810F0CF.quest_subtitle: "Reach World Tier: Frontier"
	quest.382C37A47810F0CF.title: "&aThe Frontier"
	quest.38E5EBCA2079EF22.quest_desc: [
		"The &6Ascent&r demands stronger gear and a stronger opponent."
		""
		"Equip a complete set of &aUncommon&r Affix Gear:"
		""
		"&aUncommon Helmet"
		"&aUncommon Chestplate"
		"&aUncommon Leggings"
		"&aUncommon Boots"
		"&aUncommon Weapon"
		""
		"Then defeat an &cApothic Invader&r."
		""
		"Complete both requirements to reach the &6Ascent&r."
	]
	quest.38E5EBCA2079EF22.quest_subtitle: "The Frontier was only the beginning."
	quest.38E5EBCA2079EF22.title: "&6The Ascent"
	quest.3A41A00BEF324EF3.quest_desc: [
		"Shelves are the foundation of an Apothic Enchanting setup. Different shelves provide different combinations of &2Eterna&f, &4Quanta&f, and &5Arcana&f, allowing you to customize your Enchanting Table."
		""
		"There are &e32&r valid bookshelf positions around an &bApothic Enchanting Table&f. "
		""
		"Shelves need an &7air block&r between them and the table to provide their stats."
		""
		"&2Eterna&r determines the available enchantment level and how powerful your enchantments can be."
		""
		"&4Quanta&f changes the enchantment pool, increasing the variety of enchantments available. However, too much Quanta can also make weaker enchantments more likely."
		""
		"&5Arcana&r influences the rarity and quality of the enchantments you can obtain."
		""
		"Each shelf has its own &2Eterna cap&f. Once that limit is reached, additional Eterna from that shelf is ignored."
		""
		"&aTip:&r Experiment with different shelf combinations to find the perfect balance of Eterna, Quanta, and Arcana for your enchanting setup."
	]
	quest.3A41A00BEF324EF3.quest_subtitle: "Build Your Enchanting Setup"
	quest.3A41A00BEF324EF3.title: "Bookshelves"
	quest.3C5915D24087ED3D.quest_desc: [
		"The &6Summit&r demands even better equipment."
		""
		"Equip a complete set of &9Rare&r Affix Gear:"
		""
		"&9Rare Helmet"
		"&9Rare Chestplate"
		"&9Rare Leggings"
		"&9Rare Boots"
		"&9Rare Weapon"
		""
		"Then defeat the &cWither&r."
		""
		"Complete both requirements to reach the &6Summit&r."
	]
	quest.3C5915D24087ED3D.quest_subtitle: "Only the strongest reach the top."
	quest.3C5915D24087ED3D.title: "&4The Summit"
	quest.3F72C49DDD72A5AD.quest_desc: [
		"The &5Augmenting Table&r lets you improve individual Affixes."
		""
		"Use &5Sigils of Enhancement&r to upgrade an Affix or reroll it."
		""
		"Unlike reforging, you can work on a specific Affix without replacing the entire set."
		""
		"Use augmentation to fine-tune your best equipment."
	]
	quest.3F72C49DDD72A5AD.quest_subtitle: "Good Affixes can become great ones."
	quest.3F72C49DDD72A5AD.title: "Perfect the Affix"
	quest.41986354B4227FFE.quest_desc: [
		"Some Affix Gear come with empty &bSockets&r."
		""
		"To socket a Gem, use a &fSmithing Table&r."
		""
		"Place your &dAffix Gear&r in the left slot and an &bApothic Gem&r in the right slot."
		""
		"If the item has an available socket, the Gem will be added to the equipment and its bonuses will take effect."
		""
		"Choose your Gems carefully - their effects can make a major difference to your build."
	]
	quest.41986354B4227FFE.quest_subtitle: "Your Gems need somewhere to go."
	quest.51E14807C39F4111.quest_desc: ["&bThe Improved Tome of Scrapping&r is the upgraded version for recovering enchantments more effectively when dismantling enchanted gear."]
	quest.51E14807C39F4111.quest_subtitle: "Recover More"
	quest.51E14807C39F4111.title: "Superior Scrapping"
	quest.546445899EA26829.quest_desc: [
		"Apothic Gems have different levels of &bPurity&r."
		""
		"&7Cracked&r"
		"&aChipped&r"
		"&9Flawed&r"
		"&5Normal&r"
		"&6Flawless&r"
		"&zPerfect&r"
		""
		"The &bGem Cutting Table&r can increase a Gem's Purity."
		""
		"Create a &bFlawless Gem&r to push your Gems to their highest normal purity."
	]
	quest.546445899EA26829.quest_subtitle: "A Gem's purity matters just as much as its rarity."
	quest.546445899EA26829.title: "&6Flawless"
	quest.557B8123056FBF8C.quest_desc: [
		"&bThe Enchantment Library&r provides a convenient way to store and manage enchantments."
		""
		"Enchanted books can be deposited into the &bLibrary&r and later retrieved when needed, allowing you to build up a collection of useful enchantments without filling your storage with countless books."
		""
		"&bThe Library&r is especially useful for keeping &6valuable&r or &drare&r enchantments until you have the perfect piece of gear to apply them to."
		""
		"Tip: Pair the &bLibrary&r with the &eTome of Extraction&r to safely transfer enchantments from your existing gear into books for storage."
	]
	quest.557B8123056FBF8C.quest_subtitle: "Store Your Enchantments"
	quest.5C8DA6A4F83731BC.quest_desc: [
		"The ultimate tool for salvaging enchantments."
		""
		"Use a &bTome of Extraction&r on an enchanted item in an &9Anvil&r to transfer all of its enchantments onto an &eEnchanted Book&r."
		""
		"Unlike the &bTome of Scrapping&r, the original item is preserved."
		""
		"&bTome of Scrapping&r: Extracts half of the enchantments and destroys the item."
		"&bTome of Superior Scrapping&r: Extracts all enchantments but destroys the item."
		"&bTome of Extraction&r: Extracts all enchantments and preserves the item."
		""
		"Perfect for moving valuable enchantments onto better gear without losing the original item."
	]
	quest.5C8DA6A4F83731BC.quest_subtitle: "Extract Without Sacrifice"
	quest.62CF33223F7108D6.quest_desc: [
		"Not every Affix Item is worth keeping."
		""
		"The &5Salvaging Table&r lets you break down unwanted Affix Gear into &6Rarity Materials&r."
		""
		"These materials are useful for improving your equipment and progressing through Apotheosis."
		""
		"Craft a &5Salvaging Table&r and put your unwanted loot to use."
	]
	quest.62CF33223F7108D6.quest_subtitle: "Unwanted gear can still be useful."
	quest.62CF33223F7108D6.title: "Salvaging"
	quest.64F025DAA4A9D40C.quest_desc: [
		"All Apotheosis Gems can be reduced to"
		"&bGem Dust&r through crushing."
		""
		"One method is to crush them with an"
		"&fAnvil&r in-world."
		""
		"Once you've crushed a few Gems with an"
		"&fAnvil&r, you can create and use the"
		"&5Salvaging Table&r instead."
	]
	quest.64F025DAA4A9D40C.quest_subtitle: "Not every Gem needs to remain intact."
	quest.752C5D1FE766F040.quest_desc: [
		"Two &bFlawless Gems&r of the same type and rarity can be combined at the &bGem Cutting Table&r to create a &6Perfect Gem&r."
		""
		"Perfect Gems represent the highest possible Purity."
		""
		"Create one and take your Gems to their absolute limit."
	]
	quest.752C5D1FE766F040.quest_subtitle: "There is no room for improvement."
	quest.752C5D1FE766F040.title: "&z&lPerfect"
	quest.7A699D1A92A84C51.quest_desc: [
		"&8Pickaxes&r, &3Fishing&r and &9Other Tomes&r cover specialized item categories. "
		""
		"&9The Other Tome&r handles enchantments that do not fit the other categories."
	]
	quest.7A699D1A92A84C51.quest_subtitle: "Specialized categories"
	quest.7A699D1A92A84C51.title: "Tomes of Utility"
	quest.7C11028E6B1F402B.quest_desc: ["&bArmor Tomes&r restrict their stored enchantments to the relevant armor category, making focused gear progression much easier."]
	quest.7C11028E6B1F402B.quest_subtitle: "Target armor enchantments"
	quest.7C11028E6B1F402B.title: "Tomes of Armor"
	quest.7F3584DB86B09C4D.quest_desc: [
		"Your enchanting setup isn't limited to &bShelves&f."
		""
		"Certain blocks can provide additional bonuses when placed around your &bApothic Enchanting Table&f."
		""
		"&6Candles&f increase the &2Eterna&f of your enchanting setup, helping you reach higher enchantment levels."
		""
		"&6Mob Heads and Skulls&f provide different bonuses depending on the type used. Some can improve your &4Quanta&f, &2Arcana&f, or other enchanting stats."
		""
		"These effects work alongside your shelves, allowing you to fine-tune your enchanting setup without replacing valuable shelf slots."
		""
		"&aTip:&r Experiment with different candles and mob heads to squeeze extra stats out of your enchanting setup.&f"
	]
	quest.7F3584DB86B09C4D.quest_subtitle: "Enhance Your Enchanting Setup"
	quest.7F3584DB86B09C4D.title: "Enchanting Catalysts"
