{
	quest.1610E88D5231E670.quest_desc: [
		"The &bThermal Evaporation Controller&r is the heart of a &eThermal Evaporation Plant&r, allowing you to concentrate &9fluids&r by evaporating the water within them."
		""
		"Feed a suitable &9fluid&r into the plant and provide &eheat&r to increase its concentration, producing more concentrated fluids as water is removed."
		""
		"The exact products depend on what you put in. Check your &bEMI&r to see what your plant can produce."
		""
		"Some recipes require multiple stages of evaporation, so don't be surprised if your first tower isn't enough!"
	]
	quest.1610E88D5231E670.quest_subtitle: "Concentrate fluids through evaporation"
	quest.1610E88D5231E670.title: "Thermal Evaporation Controller"
	quest.1A885E0BA312B916.quest_desc: [
		"The &bResistive Heater&r converts &eFE&r into &cHeat&r, giving you a reliable way to supply heat to your &eThermal Evaporation Plant&r."
		""
		"Connect it to the plant's &cThermal Evaporation Valve&r to transfer the generated &cHeat&r directly into the tower."
		""
		"Use it when you need a controllable heat source for increasing the temperature and improving the evaporation process."
	]
	quest.1A885E0BA312B916.quest_subtitle: "Turn FE into heat"
	quest.1A885E0BA312B916.title: "Resistive Heater"
	quest.1DE9A85C2E5348D1.quest_desc: [
		"The &bFusion Reactor Controller&r is the control center of your &dFusion Reactor&r, managing the reactor's operation and keeping the reaction under control."
		""
		"Once your reactor is assembled, it needs a steady supply of &9fuel&r and &bcoolant&r to maintain the reaction."
		""
		"Keep the reactor properly fueled and cooled, and the controller will handle the rest - turning an incredibly powerful fusion reaction into a reliable source of &eFE&r."
		""
		"Keep an eye on your inputs, though. Fusion power is impressive, but it isn't particularly forgiving."
	]
	quest.1DE9A85C2E5348D1.quest_subtitle: "Control the heart of fusion power"
	quest.1DE9A85C2E5348D1.title: "Fusion Reactor Controller"
	quest.22A2121A25A010AB.quest_desc: [
		"&bInduction Cells&r are the main storage component of an &dInduction Matrix&r."
		""
		"Each cell adds energy storage to the matrix, allowing you to build an enormous centralized power bank."
		""
		"Higher-tier cells provide significantly more storage, letting your matrix hold increasingly massive amounts of &eFE&r."
		""
		"Combine them with &bInduction Providers&r to increase the rate at which energy can be transferred in and out of the matrix."
	]
	quest.22A2121A25A010AB.quest_subtitle: "Expand your energy storage"
	quest.22A2121A25A010AB.title: "Induction Cells"
	quest.2675A4EA019B383F.quest_desc: [
		"Your reactor can produce an incredible amount of &9steam&r, but there's no point making all that steam if you can't put it to work."
		""
		"The &bIndustrial Turbine&r converts &9steam&r into &eFE&r by spinning its internal rotor and generating power."
		""
		"Build the central turbine components and surround them with the required multiblock structure. Connect the turbine to your reactor's steam output and watch the power roll in."
		""
		"Larger turbines can process more &9steam&r and generate more &eFE&r, making them an essential part of a serious power-generation setup."
	]
	quest.2675A4EA019B383F.quest_subtitle: "Turn steam into power"
	quest.2675A4EA019B383F.title: "Turbine Time"
	quest.272E31F15A39517B.quest_desc: [
		"The &bFusion Reactor Frame&r is the foundation of Mekanism's most powerful energy system."
		""
		"Build a multiblock structure from &bFusion Reactor Frames&r to contain the &dFusion Reactor&r and its incredibly powerful reaction."
		""
		"The frame forms the walls of the reactor, working together with the other required components to create a functioning fusion system."
		""
		"Once assembled, you'll be able to harness &dFusion Power&r on a scale far beyond conventional generators."
	]
	quest.272E31F15A39517B.quest_subtitle: "Build the heart of fusion power"
	quest.272E31F15A39517B.title: "Fusion Reactor Frame"
	quest.2821236A1E8FEF73.quest_desc: [
		"The &bFusion Reactor Port&r is a reinforced passage into the center of the &bFusion Reactor&r."
		""
		"Without anything &6connected&r to it, it's as strong as the frame, but with something &6connected&r it provides a &a1 way&r protected passage in or out of the core."
	]
	quest.2821236A1E8FEF73.title: "Fusion Reactor Port"
	quest.2ADDD30536A7FF68.quest_desc: [
		"&bReactor Glass&r is used as the viewing panels of your &dFusion Reactor&r, allowing you to see the reaction happening inside."
		""
		"Unlike ordinary glass, it's built to withstand the extreme conditions of a fusion reaction."
		""
		"Build it into the reactor walls to get a clear view of all that beautiful &dFusion Power&r."
		""
		"Just don't stand too close if something goes wrong."
	]
	quest.2ADDD30536A7FF68.quest_subtitle: "See the power within"
	quest.2B3B96DDFE5D3ACA.quest_desc: [
		"With &bBoiler Casings&r, you can build a &eThermoelectric Boiler&r to turn external &cHeat&r into &9Steam&r."
		""
		"The boiler is especially useful when you have excess heat that would otherwise go to waste, giving you another way to produce steam for your &bIndustrial Turbine&r."
		""
		"It can also make use of &dSuperheated Liquid Sodium&r produced by an active &cFission Reactor&r, allowing you to convert your reactor's heat into even more useful &9Steam&r."
		""
		"Pair it with an &bIndustrial Turbine&r to turn that steam into &eFE&r and build a complete heat-to-power system."
	]
	quest.2B3B96DDFE5D3ACA.quest_subtitle: "Turn heat into steam"
	quest.2B3B96DDFE5D3ACA.title: "Boiler Casing"
	quest.3689AAE9D0DB96FB.quest_desc: [
		"The &bThermal Evaporation Valve&r is the interface between your &eThermal Evaporation Plant&r and the outside world."
		""
		"Use valves to &9input&r and &9extract fluids&r from the tower. You'll need separate valves for the inputs and outputs of your setup."
		""
		"Valves can also transfer &cHeat&r into the tower when connected to a &bThermodynamic Conductor&r network, giving you another way to heat your evaporation plant."
		""
		"Plan your valve placement carefully - a well-connected tower makes managing your &9fluids&r and &cheat&r much easier."
	]
	quest.3689AAE9D0DB96FB.quest_subtitle: "Connect your evaporation tower"
	quest.3689AAE9D0DB96FB.title: "Thermal Evaporation Valve"
	quest.37A89C0012C86E9A.quest_desc: [
		"Harness the wind with the &bLarge Wind Generator&r."
		""
		"It produces between &a90,000 FE/t&r and &a150,000 FE/t&r depending on altitude, without consuming any fuel."
		""
		"Build it high above the ground to take advantage of stronger winds and maximize its &eFE&r output."
	]
	quest.37A89C0012C86E9A.quest_subtitle: "Harness the power of the wind, MK2"
	quest.3C6E442CEB73191F.quest_desc: [
		"The &bGas-Burning Generator&r can use a plethora of &cflammable gases&r to generate &eelectricity&r. "
		""
		"Gases like &7Hydrogen&r and &dEthene&r can be good for a large amount of &epower&r early on. "
		""
		"Check your &dEMI&r to see which &7gases&r are truly &cflammable&r and how much &6power&r you can generate with them."
	]
	quest.3C6E442CEB73191F.quest_subtitle: "Burn gas for massive power"
	quest.3C6E442CEB73191F.title: "Gas-Burning Generator"
	quest.3D5B74D9663AAB5A.quest_desc: [
		"The &bHeat Generator&r is a simple source of energy that relies on &cheat sources&r surrounding it. "
		""
		"The &bGenerator&r can take in &cheat&r from &a7&r locations, &a6&r of which are it's different faces. Another is the generator itself which can be &4lava-logged&r. It doesnt &6generate&r a lot of power, but for the beginning of your journey, it's plenty!"
		""
		"Not only will &cheat&r emitting &bblocks&r and &7fluids&r generate power, but heat from &bThermodynamic Conductors&r as well."
	]
	quest.3D5B74D9663AAB5A.quest_subtitle: "Turn heat into power!"
	quest.3D5B74D9663AAB5A.title: "Heat Generator"
	quest.400274581B9BD5FC.quest_desc: [
		"The &bLaser Focus Matrix&r is the ignition system for your &dFusion Reactor&r."
		""
		"It focuses the beam from a powerful &cLaser&r directly into the reactor's core, providing the energy needed to start the fusion reaction."
		""
		"Once the reactor is ready, send a &cLaser&r pulse into the matrix and watch the reaction come to life."
		""
		"Just make sure your reactor is properly prepared before you pull the trigger."
	]
	quest.400274581B9BD5FC.quest_subtitle: "Ignite the fusion reaction"
	quest.436C9C6FF59C4FD5.quest_desc: [
		"&bInduction Providers&r determine how quickly energy can be transferred into and out of your &dInduction Matrix&r."
		""
		"Each provider adds transfer capacity to the matrix, allowing it to charge and discharge &eFE&r at a higher rate."
		""
		"Higher-tier providers offer vastly greater transfer rates, letting your matrix keep up with increasingly powerful generators and machines."
		""
		"Balance your &bInduction Cells&r and &bInduction Providers&r to build a storage system with both massive capacity and high throughput."
	]
	quest.436C9C6FF59C4FD5.quest_subtitle: "Move power at scale"
	quest.436C9C6FF59C4FD5.title: "Induction Providers"
	quest.4EA0C90A02A43131.quest_desc: [
		"The &bPressurized Reaction Chamber&r is a versatile machine that combines &fsolids&r, &9fluids&r, and &eGases&r to create new materials."
		""
		"Many of Mekanism's more advanced processing chains rely on the PRC, making it an important step toward more complex automation."
		""
		"Provide the required inputs and let the chamber handle the reaction. Check your &6EMI&r to discover its available recipes and what each one requires."
		""
		"From &2Bio Fuel&r and &eHydrogen&r to advanced materials, you'll be using this machine quite a lot as your factory grows."
	]
	quest.4EA0C90A02A43131.quest_subtitle: "Combine matter under pressure"
	quest.4EA0C90A02A43131.title: "Pressurized Reaction Chamber"
	quest.4FBA0ECAC8AEBCD8.quest_desc: [
		"The &bFission Fuel Assembly&r holds the &dFissile Fuel&r that powers your &cNuclear Reactor&r."
		""
		"Build multiple assemblies into the reactor core, with &eControl Rod Assemblies&r placed directly above them to control the &cchain reaction&r."
		""
		"The more fuel assemblies you add, the greater your reactor’s potential output - but also the more &cheat&r you’ll need to manage."
		""
		"Once everything is assembled, keep a steady supply of &9coolant&r flowing through the reactor to keep it running safely."
		""
		"Keep a close eye on your reactor. Unlike most power generators, a fission reactor can have some rather &cexplosive&r consequences when things go wrong."
	]
	quest.4FBA0ECAC8AEBCD8.quest_subtitle: "Harness the atoms"
	quest.4FBA0ECAC8AEBCD8.title: "Nuclear Fission"
	quest.50D1398BBF8DBBB2.quest_desc: [
		"The &bElectrolytic Separator&r uses &eFE&r to break certain &9fluids&r down into their elemental components through &6electrolysis&r."
		""
		"Feed it the appropriate fluid and it will separate it into useful &dGases&r for your production chains."
		""
		"This machine is essential for producing several key chemicals, including &bHydrogen&r and &eOxygen&r."
		""
		"Check your &6EMI&r to discover which fluids can be separated and what each process produces."
	]
	quest.50D1398BBF8DBBB2.quest_subtitle: "Split fluids with electricity"
	quest.50D1398BBF8DBBB2.title: "Electrolytic Separator"
	quest.52AD3D58B644AA30.quest_desc: [
		"The &bWind Generator&r produces &epower&r using the &7wind&r! "
		""
		"It's a \"&aplace and play&r\" meaning that there is no need for human interaction."
	]
	quest.52AD3D58B644AA30.quest_subtitle: "Harness the power of the wind"
	quest.52AD3D58B644AA30.title: "Wind Generator"
	quest.5AB4D1D72EFD4428.quest_desc: [
		"The &bInduction Port&r is the interface between your factory and the &dInduction Matrix&r."
		""
		"Use it to &einput&r and &eoutput&r &eFE&r, allowing the matrix to charge and discharge energy to connected machines and power networks."
		""
		"Multiple ports can be used to handle different energy connections, giving you greater control over how your &dInduction Matrix&r interacts with the rest of your power grid."
	]
	quest.5AB4D1D72EFD4428.quest_subtitle: "Connect your energy storage"
	quest.5AB4D1D72EFD4428.title: "Induction Port"
	quest.60AEE273431548B6.quest_desc: [
		"The &bPressure Disperser&r helps regulate pressure inside your &eThermoelectric Boiler&r and &bIndustrial Turbine&r."
		""
		"Place it within the multiblock structure to provide a controlled &6pressure relief&r when pressure builds too high."
		""
		"Proper pressure management keeps your multiblocks running safely and prevents dangerous overpressure situations."
		""
		"Make sure your boiler and turbine have adequate pressure management before putting them under heavy load."
	]
	quest.60AEE273431548B6.quest_subtitle: "Keep pressure under control"
	quest.60AEE273431548B6.title: "Pressure Disperser"
	quest.6137C9FB49DB4A9C.quest_desc: ["Process organic materials into &2Bio Fuel&r, a versatile fuel for your factory. Burn it directly in a &eBio Generator&r for power, or use it with &bHydrogen&r in the &ePressurized Reaction Chamber&r to produce &dEthylene&r."]
	quest.6137C9FB49DB4A9C.quest_subtitle: "Turning organic matter into energy"
	quest.7610F9A545A15194.quest_desc: [
		"The &bSolar Generator&r uses the &6sun&r to generate &epower&r. "
		""
		"Obviously, when the &6sun&r is down, no &epower&r is generated. "
	]
	quest.7610F9A545A15194.quest_subtitle: "Harness the sunlight"
	quest.7610F9A545A15194.title: "Solar Generator"
	quest.7921D6460E480F82.quest_desc: [
		"The &bBoiler Valve&r connects your &eThermoelectric Boiler&r to the rest of your factory."
		""
		"Use it to &cinput&r &cHeat&r and &9Water&r into the boiler."
		""
		"The valve can also &aextract&r the &7Steam&r produced by the boiler, allowing you to send it directly to an &bIndustrial Turbine&r or store it for later."
		""
		"Use multiple valves to keep your inputs and outputs flowing efficiently."
	]
	quest.7921D6460E480F82.quest_subtitle: "Connect heat, water, and steam"
	quest.7921D6460E480F82.title: "Boiler Valve"
	quest.7BEA5B1D1B410E82.quest.desc: ["The &3Advanced Solar Generator&r is an upgraded version of the small &3Solar Generator&r and provides much more &apower&r. You can &6place&r them in the top corners of the &3Thermal Evaporation Tower&r with the green power &aenergy output&r facing the &3Thermal Evaporation Block&r to &6increase&r the &cheat&r of the tower in the day."]
	quest.7BEA5B1D1B410E82.quest_desc: [
		"The &bAdvanced Solar Generator&r is an upgraded version of the small &3Solar Generator&r and provides much more &apower&r. "
		""
		"You can &6place&r them in the top corners of the &bThermal Evaporation Tower&r with the green power &aenergy output&r facing the &bThermal Evaporation Block&r to &6increase&r the &cheat&r of the tower in the day."
	]
	quest.7BEA5B1D1B410E82.quest_subtitle: "More power from the sun"
	quest.7BEA5B1D1B410E82.title: "Advanced Solar Generator"
	quest.7FC6AE9DB7C1DA52.quest_desc: [
		"The &bBio-Generator&r takes &2biofuel&r to generate &epower&r. "
		""
		"You can make &2biofuel&r by &6crushing down&r almost any &borganic based material&r."
	]
	quest.7FC6AE9DB7C1DA52.quest_subtitle: "Turn waste into power"
	quest.7FC6AE9DB7C1DA52.title: "Bio-Generator"
	task.22915CF7043550CD.title: "Induction Cells"
	task.644BA76D2324EF21.title: "Induction Providers"
}
