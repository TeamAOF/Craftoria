	quest.5FFDA262D7693860.quest_subtitle: "Waste Reclaimed"
	quest.5FFDA262D7693860.title: "Polonium Pellet"
	quest.60F4F5FE0C3748C3.quest_desc: [
		"The &dChemical Washer&r uses &9water&r to clean &dslurries&r and prepare them for &bcrystallization&r."
		""
		"This is the final stage of &a500% ore processing&r, turning your processed slurry into the materials needed for advanced &bresource production&r."
	]
	quest.60F4F5FE0C3748C3.quest_subtitle: "The Final Step"
	quest.60F4F5FE0C3748C3.title: "Chemical Washer"
	quest.632BE5724D2120EB.quest_desc: [
		"&bReinforced Alloy&r is an elite material created by &6infusing&r &bDiamond&r into &cInfused Alloy&r."
		""
		"This powerful alloy is required to build the next tier of &5Mekanism&r machinery, so you'll want to start producing a good supply."
	]
	quest.632BE5724D2120EB.quest_subtitle: "Strengthen your alloys for the next tier"
	quest.632BE5724D2120EB.title: "Reinforced Alloy"
	quest.6387004E98403CCE.quest_desc: [
		"The &bChemical Crystallizer&r takes &dpurified ore slurry&r and &9crystallizes&r it into solid crystals."
		""
		"This is the next step in your ore processing chain, preparing the material for further &6processing&r and refinement."
	]
	quest.6387004E98403CCE.quest_subtitle: "Crystal Clear"
	quest.6387004E98403CCE.title: "Chemical Crystallizer"
	quest.67D5ED5703F35A2D.quest_desc: [
		"The &bSolar Neutron Activator&r directs &cneutron radiation&r from the &eSun&r into an internal reservoir, creating specific &9isotopes&r."
		""
		"Use it to &6repurpose &anuclear waste&r into useful &3radioactive isotopes&r, opening the door to some of Mekanism's more advanced processing chains."
	]
	quest.67D5ED5703F35A2D.quest_subtitle: "Turn sunlight into something radioactive"
	quest.67D5ED5703F35A2D.title: "Solar Neutron Activator"
	quest.68C8CDDDD7EA8A48.quest_desc: [
		"The &bSPS Port&r is how you feed &bresources&r into your &bSupercritical Phase Shifter&r and retrieve its outputs."
		""
		"You’ll need these to connect the SPS to your infrastructure and keep everything flowing."
	]
	quest.68C8CDDDD7EA8A48.quest_subtitle: "Connecting the SPS"
	quest.68C8CDDDD7EA8A48.title: "SPS Port"
	quest.693C902E4E926BB4.quest_desc: [
		"The &bChemical Oxidizer&r is used to convert &bsolids&r into their &egaseous&r forms."
		""
		"Feed it the appropriate solid material and the Oxidizer will &6oxidize&r it into a chemical gas that can be used in further &bprocessing&r and reactions."
		""
		"It’s a simple but important step toward more advanced &bchemical processing&r, especially when your recipes start demanding gases instead of raw materials."
		""
		"Sometimes, the easiest way to handle a solid is to turn it into a gas."
	]
	quest.693C902E4E926BB4.quest_subtitle: "Turn solids into gases"
	quest.693C902E4E926BB4.title: "Chemical Oxidizer"
	quest.69B079DABB860AEF.quest_desc: [
		"The &dUltimate Control Circuit&r is the pinnacle of &bMekanism&r circuitry, built to handle the most demanding machines and systems."
		""
		"Crafted with &5refined obsidian&r, it provides the strength and reliability needed when &cmaximum performance&r is required."
	]
	quest.69B079DABB860AEF.quest_subtitle: "Built for the Extreme"
	quest.69B079DABB860AEF.title: "Ultimate Control Circuit"
	quest.6A382549A4C55A5E.quest_desc: [
		"The &cAdvanced Control Circuit&r is the next tier of &6circuitry&r, used to build more powerful and &cadvanced machinery&r."
		""
		"You'll need plenty of these as you progress into the more demanding parts of &5Mekanism&r."
	]
	quest.6A382549A4C55A5E.quest_subtitle: "The next step in advanced machinery"
	quest.6A382549A4C55A5E.title: "Advanced Control Circuit"
	quest.703C1F1E9A6F4A9E.quest_desc: [
		"The &bChemical Infuser&r allows you to combine &egases&r together to create a new &bsingle product&r."
		""
		"Feed it the required gases and it will &6react&r them together, producing useful chemicals for more advanced &bprocessing&r and &6Mekanism&r recipes."
		""
		"As you progress, you’ll encounter more recipes that require combining gases in this way."
		""
		"Two gases enter. One product leaves."
	]
	quest.703C1F1E9A6F4A9E.quest_subtitle: "Combine gases into something greater"
	quest.703C1F1E9A6F4A9E.title: "Chemical Infuser"
	quest.71DD555551705B17.quest_desc: [
		"One of the first uses for &8Steel&r is the &bDynamic Tank&r."
		""
		"It’s a &emultiblock&r storage system designed to hold massive amounts of &bfluids&r, including &egases&r. Build the tank larger to dramatically increase its storage capacity."
		""
		"Dynamic Tanks are especially useful for keeping large-scale &bprocessing&r and &epower generation&r systems supplied without relying on dozens of smaller containers."
		""
		"When a barrel won’t cut it, build a tank."
	]
	quest.71DD555551705B17.quest_subtitle: "Store your fluids at scale"
	quest.71DD555551705B17.title: "Dynamic Tank"
	quest.740B34D7D1AF3FF0.quest_desc: [
		"The &bCrusher&r is a machine used to &6crush&r items and blocks into &7dusts&r and other &9materials&r."
		""
		"It's a simple but essential part of &5Mekanism&r's processing chain, letting you break down resources into useful components for further &6processing&r."
	]
	quest.740B34D7D1AF3FF0.quest_subtitle: "Break it down, one block at a time"
	quest.740B34D7D1AF3FF0.title: "Crusher"
	quest.79515634992D02A3.quest_desc: [
		"You can now take the &dAntimatter Gas&r produced by the SPS and solidify it into an &dAntimatter Pellet&r."
		""
		"This incredibly powerful material is used to craft some of the most &6powerful&r upgrades and machines available to you."
		""
