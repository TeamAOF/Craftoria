	]
	quest.79515634992D02A3.quest_subtitle: "Harnessing Antimatter"
	quest.79515634992D02A3.title: "Antimatter"
	quest.7BB4CE27736F4C08.quest_desc: [
		"The final piece of your &bDynamic Tank&r is the &bDynamic Valve&r."
		""
		"Place it anywhere on the &emultiblock&r to gain access to the tank’s contents. It allows you to connect &6pipes&r and &6hoses&r to either &apump fluids in&r or &cpump fluids out&r of the tank."
		""
		"Add as many valves as you need to keep your fluid network flowing."
		""
		"Fill it, drain it, automate it."
	]
	quest.7BB4CE27736F4C08.quest_subtitle: "Control your tank's flow"
	quest.7BB4CE27736F4C08.title: "Dynamic Valve"
