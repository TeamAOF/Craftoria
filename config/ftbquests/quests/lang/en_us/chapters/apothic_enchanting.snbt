{
	quest.10BD26FC074B3066.quest_desc: [
		"The ultimate evolution of the &bEnchantment Library&r."
		""
		"The &zLibrary of Alexandria&r greatly expands your ability to store enchantments, making it easier to build and maintain a collection of powerful enchanted books."
		""
		"Store your accumulated enchantment knowledge here and retrieve it whenever you need it, instead of keeping piles of enchanted books in storage."
		""
		"This is the final step in building a dedicated enchantment library."
		""
		"Tip: Combine this with the &eTome of Extraction&r to safely move powerful enchantments from existing gear into your collection."
	]
	quest.10BD26FC074B3066.quest_subtitle: "Master the Art of Enchanting"
	quest.14DDF01D6F7D46A7.quest_desc: [
		"&bThe Enchanting Table of the Raven&r allows direct customization of the core enchanting stats. "
		""
		"Use it when you want &eprecise control&r over your enchanting setup."
	]
	quest.14DDF01D6F7D46A7.quest_subtitle: "Manual stat control"
	quest.14DDF01D6F7D46A7.title: "The Raven Knows"
	quest.1CD3AD0FB5604882.quest_desc: ["Craft the &bApothic Enchanting Table&r and begin using &2Eterna&r, &4Quanta&r and &5Arcana&r to push enchanting beyond vanilla limits, with progression reaching level 100."]
	quest.1CD3AD0FB5604882.quest_subtitle: "Begin the overhaul"
	quest.1CD3AD0FB5604882.title: "The Secrets of Enchanting"
	quest.21474801C1472EF7.quest_desc: [
		"A &bTome of Scrapping&r lets you remove enchantments from an item and recover them as enchanted books."
		""
		"The process is lossy - only half of the item's enchantments are recovered, and the original item is destroyed."
		""
		"For a complete extraction without destroying the item, use a Tome of Extraction instead."
		""
		"Tip: Use the &bTome of Superior Scrapping&r if you want to recover all of the enchantments but don't mind sacrificing the item."
	]
	quest.21474801C1472EF7.quest_subtitle: "Salvage Enchantments"
	quest.2936EE38CEAB4337.quest_desc: ["&bWeapon&r and &bBow Tomes&r focus on combat-related enchantments and help keep your specialized enchantment collections organized."]
	quest.2936EE38CEAB4337.quest_subtitle: "Target combat enchantments"
	quest.2936EE38CEAB4337.title: "Tomes of Combat"
	quest.3A41A00BEF324EF3.quest_desc: [
		"Shelves are the foundation of an Apothic Enchanting setup. Different shelves provide different combinations of &2Eterna&f, &4Quanta&f, and &5Arcana&f, allowing you to customize your Enchanting Table."
		""
		"There are &e32&r valid bookshelf positions around an &bApothic Enchanting Table&f. "
		""
		"Shelves need an &7air block&r between them and the table to provide their stats."
		""
		"&2Eterna&r determines the available enchantment level and how powerful your enchantments can be."
		""
		"&4Quanta&f changes the enchantment pool, increasing the variety of enchantments available. However, too much Quanta can also make weaker enchantments more likely."
		""
		"&5Arcana&r influences the rarity and quality of the enchantments you can obtain."
		""
		"Each shelf has its own &2Eterna cap&f. Once that limit is reached, additional Eterna from that shelf is ignored."
		""
		"&aTip:&r Experiment with different shelf combinations to find the perfect balance of Eterna, Quanta, and Arcana for your enchanting setup."
	]
	quest.3A41A00BEF324EF3.quest_subtitle: "Build Your Enchanting Setup"
	quest.3A41A00BEF324EF3.title: "Bookshelves"
	quest.51E14807C39F4111.quest_desc: ["&bThe Improved Tome of Scrapping&r is the upgraded version for recovering enchantments more effectively when dismantling enchanted gear."]
	quest.51E14807C39F4111.quest_subtitle: "Recover More"
	quest.51E14807C39F4111.title: "Superior Scrapping"
	quest.557B8123056FBF8C.quest_desc: [
		"&bThe Enchantment Library&r provides a convenient way to store and manage enchantments."
		""
		"Enchanted books can be deposited into the &bLibrary&r and later retrieved when needed, allowing you to build up a collection of useful enchantments without filling your storage with countless books."
		""
		"&bThe Library&r is especially useful for keeping &6valuable&r or &drare&r enchantments until you have the perfect piece of gear to apply them to."
		""
		"Tip: Pair the &bLibrary&r with the &eTome of Extraction&r to safely transfer enchantments from your existing gear into books for storage."
	]
	quest.557B8123056FBF8C.quest_subtitle: "Store Your Enchantments"
	quest.5C8DA6A4F83731BC.quest_desc: [
		"The ultimate tool for salvaging enchantments."
		""
		"Use a &bTome of Extraction&r on an enchanted item in an &9Anvil&r to transfer all of its enchantments onto an &eEnchanted Book&r."
		""
		"Unlike the &bTome of Scrapping&r, the original item is preserved."
		""
		"&bTome of Scrapping&r: Extracts half of the enchantments and destroys the item."
		"&bTome of Superior Scrapping&r: Extracts all enchantments but destroys the item."
		"&bTome of Extraction&r: Extracts all enchantments and preserves the item."
		""
		"Perfect for moving valuable enchantments onto better gear without losing the original item."
	]
	quest.5C8DA6A4F83731BC.quest_subtitle: "Extract Without Sacrifice"
	quest.7A699D1A92A84C51.quest_desc: [
		"&8Pickaxes&r, &3Fishing&r and &9Other Tomes&r cover specialized item categories. "
		""
		"&9The Other Tome&r handles enchantments that do not fit the other categories."
	]
	quest.7A699D1A92A84C51.quest_subtitle: "Specialized categories"
	quest.7A699D1A92A84C51.title: "Tomes of Utility"
	quest.7C11028E6B1F402B.quest_desc: ["&bArmor Tomes&r restrict their stored enchantments to the relevant armor category, making focused gear progression much easier."]
	quest.7C11028E6B1F402B.quest_subtitle: "Target armor enchantments"
	quest.7C11028E6B1F402B.title: "Tomes of Armor"
	quest.7F3584DB86B09C4D.quest_desc: [
		"Your enchanting setup isn't limited to &bShelves&f."
		""
		"Certain blocks can provide additional bonuses when placed around your &bApothic Enchanting Table&f."
		""
		"&6Candles&f increase the &2Eterna&f of your enchanting setup, helping you reach higher enchantment levels."
		""
		"&6Mob Heads and Skulls&f provide different bonuses depending on the type used. Some can improve your &4Quanta&f, &2Arcana&f, or other enchanting stats."
		""
		"These effects work alongside your shelves, allowing you to fine-tune your enchanting setup without replacing valuable shelf slots."
		""
		"&aTip:&r Experiment with different candles and mob heads to squeeze extra stats out of your enchanting setup.&f"
	]
	quest.7F3584DB86B09C4D.quest_subtitle: "Enhance Your Enchanting Setup"
	quest.7F3584DB86B09C4D.title: "Enchanting Catalysts"
	task.1605ACA907712B09.title: "Skulls and Candles"
	task.24A76A503F53AA7B.title: "Bookshelves"
	task.57F02AA9BFBA7624.title: "Enchanting Tables"
	task.597ECA1E95F8C178.title: "Tomes of Armor"
}
