{
	quest.1610E88D5231E670.quest_desc: ["El &bControlador de Evaporación Térmica&r es el cerebro de tus nuevas torres de evaporación. Estas torres se usan para tomar un &7fluido&r y &6evaporar&r &7agua&r de él para &9aumentar la concentración&r de los &3sólidos disueltos&r en él. &6Revisa tu EMI&r para ver exactamente qué puedes obtener de él. &oTal vez&r necesites hacer algunas..."]
	quest.1610E88D5231E670.title: "Controlador de Evaporación Térmica"
	quest.1A885E0BA312B916.quest_desc: ["El &bCalentador Resistivo&r te permite convertir &aenergía&r en calor. Luego puedes &6introducir&r calor en la torre mediante la &bVálvula de Evaporación Térmica&r para ayudar a &raumentar&r la temperatura de la torre."]
	quest.1A885E0BA312B916.title: "Calentador Resistivo"
	quest.1DE9A85C2E5348D1.quest_desc: [
		"El &bControlador del Reactor de Fusión&r es el corazón del &bReactor de Fusión&r. "
		""
		"Se asegurará de que tu reactor funcione &asin problemas&r siempre que le proporciones el &8combustible&r y &9enfriamiento&r adecuados."
	]
	quest.1DE9A85C2E5348D1.title: "Controlador del Reactor de Fusión"
	quest.22A2121A25A010AB.quest_desc: ["Cada &bCelda de Inducción Básica&r agregada a tu matriz añade &e3.2 GFE&r de almacenamiento de energía."]
	quest.22A2121A25A010AB.title: "Celda de Inducción Básica"
	quest.2675A4EA019B383F.quest_desc: [
		"Necesitarás hacer &bTurbinas&r para &7aprovechar el vapor&r que producirás y generar &eelectricidad&r. "
		""
		"Crea la turbina central y la estructura circundante."
	]
	quest.2675A4EA019B383F.title: "Hora de Turbinas"
	quest.272E31F15A39517B.quest_desc: [
		"El primer paso para la etapa final de &egeneración de energía&r; los &bMarcos de Reactor de Fusión&r. "
		""
		"Contendrán la &4inmensamente poderosa&r reacción de fusión dentro de sus paredes."
	]
	quest.272E31F15A39517B.title: "Marco de Reactor de Fusión"
	quest.2821236A1E8FEF73.quest_desc: [
		"El &bPuerto de Reactor de Fusión&r es un paso reforzado al centro del &bReactor de Fusión&r."
		""
		"Sin nada &6conectado&r, es tan fuerte como el marco, pero con algo &6conectado&r provee un pasaje &aunidireccional&r protegido hacia o desde el núcleo."
	]
	quest.2821236A1E8FEF73.title: "Puerto de Reactor de Fusión"
	quest.2ADDD30536A7FF68.quest_desc: ["El &bVidrio de Reactor&r es un &3material transparente súper mejorado&r que puede usarse para las paredes centrales del &bReactor de Fusión&r. A todos les gusta &6ver&r colores bonitos (que pueden o no &4obliterarte&r)."]
	quest.2B3B96DDFE5D3ACA.quest_desc: ["Usando &bCarcasas de Caldera&r puedes crear una &bCaldera Termoeléctrica&r para &6generar&r &7vapor&r extra de &ccalor externo&r, incluyendo &9Sodio Líquido Sobrecalentado&r de un &bReactor de Fisión&r activo."]
	quest.2B3B96DDFE5D3ACA.title: "Carcasa de Caldera"
	quest.3689AAE9D0DB96FB.quest_desc: ["La &bVálvula de Evaporación Térmica&r &6introduce&r y &6extrae&r &7fluidos&r de la torre. Necesitas al menos &92&r para entrada/salida. También puede &6recibir&r &ccalor&r de &bConductores Termodinámicos&r."]
	quest.3689AAE9D0DB96FB.title: "Válvula de Evaporación Térmica"
	quest.3C6E442CEB73191F.quest_desc: [
		"El &bGenerador de Gas&r puede usar una gran variedad de &cgases inflamables&r para generar &eelectricidad&r. "
		""
		"Gases como el &7Hidrógeno&r y el &dEteno&r pueden ser buenos para una gran cantidad de &epoder&r al principio. "
		""
		"Revisa tu &dEMI&r para ver qué &7gases&r son realmente &cinflamables&r y cuánta &6energía&r puedes generar con ellos."
	]
	quest.3C6E442CEB73191F.title: "Generador de Gas"
	quest.3D5B74D9663AAB5A.quest_desc: [
		"El &bGenerador de Calor&r es una fuente simple de energía que depende de &cfuentes de calor&r a su alrededor. "
		""
		"El &bGenerador&r puede tomar &ccalor&r de &a7&r ubicaciones, &a6&r de las cuales son sus diferentes caras. Otra es el propio generador, que puede estar &4lleno de lava&r. No &6genera&r mucho poder, pero para el comienzo de tu viaje, ¡es suficiente!"
		""
		"No solo los &bbloques&r y &7fluidos&r que emiten &ccalor&r generarán energía, sino también el calor de los &bConductores Termodinámicos&r."
	]
	quest.3D5B74D9663AAB5A.title: "Generador de Calor"
	quest.400274581B9BD5FC.quest_desc: ["La &bMatriz de Enfoque Láser&r se usa para encender tu &bReactor de Fusión&r enfocando el haz de un &cláser&r directamente al núcleo del reactor."]
	quest.436C9C6FF59C4FD5.quest_desc: ["Cada &bProveedor de Inducción Básico&r añadido a tu matriz agrega &e102.4 kFE por tick&r de tasa de transferencia de energía, tanto de entrada como de salida de tu matriz."]
	quest.436C9C6FF59C4FD5.title: "Proveedor de Inducción Básico"
	quest.4EA0C90A02A43131.quest_desc: [
		"La &bCámara de Reacción Presurizada&r toma &3sólidos&r, &7líquidos&r y &egases&r para producir otros &3sólidos&r y &egases&r en ambiente presurizado."
		""
		"&6Revisa&r tu EMI para ver sus usos específicos."
	]
	quest.4EA0C90A02A43131.title: "Cámara de Reacción Presurizada"
	quest.4FBA0ECAC8AEBCD8.quest_desc: [
		"El &bEnsamblaje de Combustible de Fisión&r es un grupo de varillas que contienen &dcombustible fisible&r. "
		""
		"Colócalas bajo los &bEnsamblajes de Barras de Control&r."
	]
	quest.4FBA0ECAC8AEBCD8.title: "Fisión Nuclear"
	quest.50D1398BBF8DBBB2.quest_desc: ["El &bSeparador Electrolítico&r usa &eelectricidad&r para descomponer &7fluidos&r en sus elementos mediante \"&6Electrólisis&r\""]
	quest.50D1398BBF8DBBB2.title: "Separador Electrolítico"
	quest.52AD3D58B644AA30.quest_desc: [
		"¡El &bGenerador Eólico&r produce &eenergía&r usando el &7viento&r! "
		""
		"Es un \"&acoloca y listo&r\", lo que significa que no necesita interacción humana."
	]
	quest.52AD3D58B644AA30.title: "Generador Eólico"
	quest.5AB4D1D72EFD4428.quest_desc: ["El &bPuerto de Inducción&r te permitirá interactuar con tu &9Matriz de Inducción&r. "]
	quest.5AB4D1D72EFD4428.title: "Puerto de Inducción"
	quest.60AEE273431548B6.quest_desc: ["Coloca un &bDispersor de Presión&r en una turbina y caldera para regular adecuadamente la &7liberación de presión&r."]
	quest.60AEE273431548B6.title: "Dispersor de Presión"
	quest.7610F9A545A15194.quest_desc: [
		"El &bGenerador Solar&r usa la &6luz solar&r para generar &eenergía&r. "
		""
		"Obviamente, cuando no hay &6sol&r, no se genera &eenergía&r. "
	]
	quest.7610F9A545A15194.title: "Generador Solar"
	quest.7921D6460E480F82.quest_desc: [
		"Usa una &bVálvula de Caldera&r para &cintroducir calor&r y &9agua&r. "
		""
		"También para &aextraer&r &7vapor&r."
	]
	quest.7921D6460E480F82.title: "Válvula de Caldera"
	quest.7BEA5B1D1B410E82.quest.desc: ["El &3Generador Solar Avanzado&r es una versión mejorada del pequeño &3Generador Solar&r y proporciona mucha más &aenergía&r. Puedes &6colocarlos&r en las esquinas superiores de la &3Torre de Evaporación Térmica&r con la salida de energía verde &aenergía&r mirando hacia el &3Bloque de Evaporación Térmica&r para &6aumentar&r el &ccalor&r de la torre durante el día."]
	quest.7BEA5B1D1B410E82.quest_desc: [
		"El &bGenerador Solar Avanzado&r es una versión mejorada del pequeño &3Generador Solar&r y proporciona mucha más &aenergía&r. "
		""
		"Puedes &6colocarlos&r en las esquinas superiores de la &bTorre de Evaporación Térmica&r con la salida de energía verde &aenergía&r mirando hacia el &bBloque de Evaporación Térmica&r para &6aumentar&r el &ccalor&r de la torre durante el día."
	]
	quest.7BEA5B1D1B410E82.title: "Generador Solar Avanzado"
	quest.7FC6AE9DB7C1DA52.quest_desc: [
		"El &bGenerador Bio&r toma &2biocombustible&r para generar &eenergía&r. "
		""
		"Puedes hacer &2biocombustible&r &6triturando&r casi cualquier &bmaterial orgánico&r."
