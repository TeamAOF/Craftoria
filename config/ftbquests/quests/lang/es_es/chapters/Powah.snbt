{
	quest.119752DA7C1B29B6.quest_desc: [""]
	quest.292875386D7B9981.quest_desc: ["El &bUraninita&f es un mineral que puedes obtener &6minando&f. También puedes conseguirlo con la &bCantera MI&f. La &bUraninita&f es clave en Powah y se usa en muchas recetas y para alimentar el &breactor&f."]
	quest.292875386D7B9981.quest_subtitle: "Quizás quieras usar guantes"
	quest.292875386D7B9981.title: "&aUraninita"
	quest.5663A6C559490A29.quest_desc: ["&6Clic-Derecho&f la &bperla ariel&f en un &bzombi&f o &bhusk&f y estará completa."]
	quest.5663A6C559490A29.quest_subtitle: "No esperes recuperar a ese zombi"
	task.7537E40C4FAB6D5C.title: "Bienvenido a Powah"
}
