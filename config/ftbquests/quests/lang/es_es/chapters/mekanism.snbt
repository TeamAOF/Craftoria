{
	quest.048328EEBEEC9C94.quest_desc: [
		"El &bTraje Hazmat&r te protegerá de &2fugas accidentales de radiación&r."
		""
		"Necesitas &otodo&r el conjunto."
	]
	quest.048328EEBEEC9C94.title: "Hazmat"
	quest.04C21F7B2F034772.quest_desc: [
		"Usa &bBobinas Sobreenergizadas&r en el centro interior de cada cara apuntando al centro."
		""
		"Esto &6concentrará la energía&r en una &7fuente presurizada&r de &agas de polonio&r, rompiendo los átomos pesados y transformándolos en un &dGas de Antimateria&r."
	]
	quest.04C21F7B2F034772.title: "Bobina Sobreenergizada"
	quest.0C1C61B4554B38E5.quest_desc: [
		"El &bCombinador&r te permite &6combinar objetos&r juntos como una &dgema&r y &7piedra&r para obtener &8minerales&r, &ecera&r y &ccobre&r para protegerlo de los elementos, mezclar tintes, y más. "
		""
		"Consulta tu &dEMI&r para ver qué más puedes hacer con él."
	]
	quest.0C1C61B4554B38E5.title: "Combiner"
	quest.110B0C8DD2FD5BE7.quest_desc: [
		"¡Bienvenido a un mundo de &7Sólidos&r, &bLíquidos&r, &9Gases&r y &eEnergía&r!"
		""
		"&6Crearás&r y &6mejorarás&r &bmáquinas&r durante tu &aventura&r para refinar y procesar &brecursos&r, &6generar&r grandes cantidades de &eenergía&r y &7equiparte&r para enfrentarte a los &2hostiles&r del mundo."
		""
		"Asegúrate de usar tu &dEMI&r para conocer las &7líneas de procesamiento&r asociadas con cada &bmaterial&r."
		""
		"El &bOsmio&r es uno de los &3recursos&r más importantes que usarás."
		""
		"Es el &7metal&r principal de cada &acircuito&r que utilizarás."
		""
		"¿Sabías que el &bOsmio&r es el elemento &8más denso&r que ocurre &2naturalmente&r?"
	]
	quest.110B0C8DD2FD5BE7.quest_subtitle: "¡Un mundo de automatización te espera!"
	quest.110B0C8DD2FD5BE7.title: "&fBienvenido a &aMekanism"
	quest.117C9FABE86447D1.quest_desc: ["El &bTransportador Cuántico&r te permite &6transportar&r &bobjetos&r, &7líquidos&r, &egases&r, &4calor&r, &dpigmentos&r, &9lodos&r, &atipos de infusión&r y &6energía&r al instante a cualquier lugar, al igual que el &bTeletransportador&r."]
	quest.117C9FABE86447D1.title: "Transportador Cuántico"
	quest.17C1F2791A6E0676.quest_desc: [
		"La &bMejora de Velocidad&r hace exactamente lo que dice."
		""
		"&6Acelera&r tus máquinas a costa de un consumo de &eenergía&r multiplicado."
		""
		"No te preocupes, ¡puedes combatir esto!"
	]
	quest.17C1F2791A6E0676.title: "Mejora de Velocidad"
	quest.17E7640F55666577.quest_desc: ["El &bExtractor de Pigmentos&r te permite tomar casi &acualquier objeto teñido&r y &6extraer el tinte&r de él, destruyendo el objeto sin teñir restante."]
	quest.1B65CA6898CC3F9E.quest_desc: [
		"La &bFábrica de Infusión Básica&r puede procesar hasta &a3&r procesos de infusión a la vez. "
		""
		"Hay un botón a la izquierda llamado \"&6Auto-Ordenar&r\" que permite a la máquina dividir automáticamente los materiales entre los &a3&r espacios de entrada. "
		""
		"La &bFábrica de Infusión Básica&r puede contener hasta &92,960 mb&r de material de infusión."
	]
	quest.1D482F0D9AF8D17E.quest_desc: [
		"La &bAleación Atómica&r es la aleación más fuerte y conductora que puedes crear. "
		""
		"Se usa &6infundiendo&r &5obsidiana refinada&r en &9Aleación Reforzada&r. "
	]
	quest.1D482F0D9AF8D17E.title: "Aleación Atómica"
	quest.1F9A1456487655B0.quest_desc: [
		"Usando tu &bNúcleo de Teletransportación&r, construye un &9Teletransportador&r para viajar instantáneamente a cualquier distancia. "
		""
		"Cada &bPortal de Teletransportador&r requiere un &9Teletransportador&r y &a9&r &bMarcos de Teletransportador&r, dando un agujero de uno por dos para que un jugador camine. "
		""
		"¡&6Configura&r una frecuencia y listo!"
	]
	quest.1F9A1456487655B0.title: "Teletransportador"
	quest.21586F8B123BFCC3.quest_desc: ["El &bBarril de Desechos&r permitirá que diferentes &2fluidos nucleares&r &7decaigan&r a un ritmo fijo."]
	quest.21586F8B123BFCC3.title: "Verdadero Poder y Verdadero Dolor"
	quest.21E51BEA3B8E3EDC.quest_desc: [
		"¡&bAcero!&r "
		""
		"La cumbre de las estructuras de máquinas y construcción. "
		""
		"Lo necesitarás para &acasi todo&r. "
		""
		"Se hace &6infundiendo doblemente&r &7hierro&r con &8carbón&r, luego &6fundiendo&r el producto. "
	]
	quest.21E51BEA3B8E3EDC.title: "Lingote de Acero"
	quest.21EE3862F6DA8E09.quest_desc: ["El &bAserradero de Precisión&r es una máquina usada para procesar &9troncos&r y otros materiales de madera con &eextrema eficiencia&r, con un subproducto de &9aserrín&r."]
	quest.21EE3862F6DA8E09.title: "Aserradero de Precisión"
	quest.22D2716905D415E5.quest_desc: [
		"La &bCámara de Enriquecimiento&r es una máquina simple que no solo te permite &6enriquecer minerales&r en dos o más &bpolvos&r, sino que también permite &6enriquecer&r muchas otras cosas, como:"
		""
		"- Flores a Polvos"
		"- Remover Musgo de Bloques"
		"- Remover Oxidación"
		"- ¡Y más!"
		""
		"Consejo: &6Enriquece&r tus tipos de infusión como carbón, redstone, diamantes, obsidiana refinada para obtener más &bmaterial de infusión&r que la gema/polvo normal."
	]
	quest.22D2716905D415E5.title: "Cámara de Enriquecimiento"
	quest.247E497BC6DE25CE.quest_desc: [
		"El &bRobit&r es un mini robot que puede usarse como &9mesa de trabajo&r, &8horno&r, &7yunque&r, &6cofre&r, o simplemente un pequeño compañero. "
		""
		"También es inmune a todo &cfuego&r."
	]
	quest.247E497BC6DE25CE.title: "Robit"
	quest.27B6C6079B5FE918.quest_desc: ["El &bCondensador Rotatorio&r te permite &6condensar&r un &egas&r a su forma &7líquida&r y viceversa presionando el botón en la esquina superior izquierda de la GUI."]
	quest.27B6C6079B5FE918.title: "Condensador Rotatorio"
	quest.2A68AB7D1EDD44BD.quest_desc: [
		"El &bVidrio Estructural&r es un bloque que puede usarse en casi cualquier &emultibloque&r como bloque transparente."
		" "
		"Recomiendo usarlo para paredes de &bTanque Dinámico&r, con bordes de bloques sólidos."
	]
	quest.2A68AB7D1EDD44BD.title: "Vidrio Estructural"
	quest.3392424E7E1B68C4.quest_desc: [
		"¿Necesitas una &bcentrífuga&r &amás rápida&r?"
		""
		"¡La &bCentrífuga Isotópica&r gira como un cohete!"
		""
		"Procesa &2desechos nucleares&r y crea &dcombustible fisible&r."
	]
	quest.3392424E7E1B68C4.title: "Centrífuga Isotópica"
	quest.34B822EC25F66B54.quest_desc: ["El &bCompresor de Osmio&r se usa para &6comprimir&r &3osmium&r en polvos y crear sus lingotes correspondientes."]
	quest.34B822EC25F66B54.title: "Compresor de Osmio"
	quest.3B0AB80C9FAD48F2.quest_desc: ["El &bNucleosintetizador Antiprotónico&r toma &dAntimateria&r gaseosa y te permite alterar la estructura molecular de algunos objetos y transformarlos en una variante más poderosa."]
	quest.3B0AB80C9FAD48F2.title: "Nucleosintetizador Antiprotónico"
	quest.3BAA7EC7653A7905.quest_desc: [
		"La &bCámara de Inyección&r te permite &6procesar&r diferentes &9minerales&r y &cminerales en bruto&r usando &7Ácido Clorhídrico&r en múltiples &efragmentos&r como primer paso hacia el &a400%&r de procesamiento de minerales. "
		""
		"También puedes usar &7oxígeno&r para &4oxidar&r forzosamente algunos materiales de cobre, vapor de agua para solidificar hormigón, revertir la cocción de arcilla y rehidratar coral muerto."
	]
	quest.3BAA7EC7653A7905.title: "Cámara de Inyección Química"
	quest.3F6174E82DDC48C3.quest_desc: ["El &bFundidor Energizado&r es una máquina usada para &6fundir&r objetos y bloques en sus contrapartes \"&8cocidas&r\"."]
	quest.3F6174E82DDC48C3.title: "Fundidor Energizado"
	quest.40EB78C0AF30096E.quest_desc: [
		"El &bInfusor Metalúrgico&r es la primera máquina que harás y usarás. Te permite &6infundir&r diferentes &bmetales&r con varias &7sustancias&r, incluyendo &botros metales&r."
		""
		"En la &3esquina inferior izquierda&r hay una &7pequeña pestaña&r que te dará &eestadísticas de energía&r al pasar el cursor sobre ella."
		""
		"En la &3esquina inferior derecha&r, debería haber un &6interruptor&r para cambiar los &4estados de control de redstone&r. "
		""
		"Por &7defecto&r, ignora las &4señales de redstone&r."
		""
		"En la &3esquina superior izquierda&r, hay un botón para &6configurar&r los lados de la &bmáquina&r. Puedes &6controlar&r qué lado &arecibe&r, &cenvía&r, &ehace ambas&r, acepta &6energía&r o no hace &7nada&r para cada medio de &brecursos&r que la máquina acepta."
		""
		"&3Justo debajo&r, hay una &7pestaña de transportador&r. Se usa junto con el &bTransportador Logístico&r para ayudar a &efiltrar&r y &adirigir&r objetos por tu espagueti de tuberías."
		""
		"En la &3esquina superior derecha&r, hay un botón con una &9flecha&r. Se usa para &6instalar&r &bmejoras&r en una &bmáquina&r. Hablaremos de las &bmejoras&r más tarde, pero solo puedes usar hasta &a32&r en cada máquina."
		""
		"&3Justo debajo&r hay un botón para &6bloquear la máquina&r y hacerla &aprivada&r solo para ti."
		""
		"En la &3parte media izquierda&r, hay un botón que dice &c\"VACIAR\"&r y te permite &6vaciar&r el &7material de infusión&r sobrante, que se muestra en la barra &3justo al lado&r."
		""
		"&3A la derecha&r, hay una &aranura verde&r. Se usa como espacio para &ealimentar&r la &bmáquina&r con un objeto. Además de los &bobjetos&r que contienen &eenergía&r como &7baterías&r, puedes alimentar máquinas con &4redstone&r, ya sea en &bpolvo o en bloque&r. Así es como podrás &ealimentar&r tus &bmáquinas&r fácilmente usando &8\"combustible\" sólido.&r Hay una alternativa de la que hablaré luego."
		""
		"La &ebarra de energía&r se muestra justo a la &3derecha&r de la ranura de energía."
	]
	quest.40EB78C0AF30096E.title: "&eLo Básico"
	quest.41604B0C59094F5E.quest_desc: [
		"Tu corazón es tu motor. "
		""
		"Si se detiene, tú también. "
		""
		"Así que &6bloquea&r todos los &cataques&r entrantes con el &bPetralito de MekaTraje&r! "
		""
		"¡Tan sólido como una roca o te devolvemos tu dinero garantizado!"
	]
	quest.41604B0C59094F5E.title: "Armadura Corporal MekaTraje"
	quest.4351715A36CA0DA6.quest_desc: [
		"El &bLicuador Nutritivo&r te permite &6triturar&r casi cualquier alimento y convertirlo en una &dPasta Nutritiva&r que puede consumirse y almacenarse a granel. "
		""
		"Como es un &7fluido&r, puedes almacenarlo en tanques. "
		""
		"Hay una ranura que te permite llenar &bCantimploras&r con la &dPasta Nutritiva&r."
	]
	quest.4351715A36CA0DA6.title: "Licuador Nutritivo"
	quest.44D8D30BCD48C4C9.quest_desc: [
		"Una &bplaca de circuito&r con un fino revestimiento de diamante, pulsando con un núcleo de aleación infundido. "
		""
		"El &6poder de procesamiento&r para manejar cálculos de un &cnivel mucho mayor&r."
	]
	quest.44D8D30BCD48C4C9.title: "Circuito de Control Élite"
	quest.45E16D69D7099581.quest_desc: ["¡Bienvenido a la era de los &bRevestimientos de Acero&r! La mayoría (si no todas) las &bmáquinas&r de ahora en adelante requerirán un revestimiento de acero para &6soportar&r y contener los &ccircuitos&r y &7mecanismos&r. Esto es parte fundamental de tu &6progresión&r."]
	quest.45E16D69D7099581.title: "Revestimiento de Acero"
	quest.462944FD21A92AED.quest_desc: ["La &4Aleación Infundida&r es la primera aleación que harás, creada al &cinfundir redstone&r en &6cobre&r para formar un metal ultraconductor que usarás en &acircuitos&r. "]
	quest.462944FD21A92AED.title: "Aleación Infundida"
	quest.478A6A8ADA223AEF.quest_desc: [
		"La &bCantimplora&r almacena &dPasta Nutritiva&r para &6consumirla&r. "
		""
		"Al comer, tomará solo lo necesario para llenar tu barra de hambre. "
		""
		"La &bCantimplora&r puede contener hasta &964,000 mb&r de &dPasta&r. "
		""
		"Cada consumo usa &9128mb&r, independientemente de cuánto llene la barra."
	]
	quest.478A6A8ADA223AEF.title: "Cantimplora"
	quest.5021D7D55A0B3533.quest_desc: ["¡Bienvenido al mundo de la &bQuímica&r! Algunos &equímicos&r son normalmente &cpeligrosos&r, pero aquí tu cuerpo es &7resistente&r a ellos."]
	quest.5021D7D55A0B3533.title: "¡Hora de Química!"
	quest.508A650402DC24F5.quest_desc: ["El revestimiento para tu &bCambiador de Fase Supercrítico&r es caro, pero resistente. "]
	quest.508A650402DC24F5.title: "Revestimiento SPS"
	quest.534B63750942C433.quest_desc: [
		"Tu primer circuito en esta línea tecnológica es el &bCircuito de Control Básico&r. "
		""
		"Es una fabricación muy simple, siendo solo &4redstone&r infundida con &9osmio&r. "
		""
		"Lo usarás mucho, haz una buena cantidad."
	]
	quest.534B63750942C433.title: "Circuito de Control Básico"
	quest.550B874D9F2D0D5A.quest_desc: [
		"El &bMinero Digital&r es un minero automático basado en &efiltros&r. "
		""
		"Dentro de su GUI, puedes especificar &efiltros&r para &9bloques&r específicos (no solo minerales) e incluso filtrar basado en una etiqueta. "
		""
		"Su radio máximo es de &a32&r bloques. "
		""
		"Para encontrar la etiqueta de un bloque, recuerda el &bDiccionario&r."
	]
	quest.550B874D9F2D0D5A.title: "Minero Digital"
	quest.566D039774A4DB9D.quest_desc: ["Crea &bPellets de Plutonio&r reutilizando los &2desechos nucleares&r y combinándolos con &9polvo de fluorita&r."]
	quest.566D039774A4DB9D.title: "Pellet de Plutonio"
	quest.56C5ECD3430B6A55.quest_desc: ["Las &bElytras Reforzadas con HDPE&r son una mejora directa a las &delytras&r normales. Estas tienen el doble de durabilidad y la capacidad de repararse con &7Hojas de HDPE&r, ¡repando &3un cuarto&r de la durabilidad por cada una!"]
	quest.56C5ECD3430B6A55.title: "Elytras Reforzadas con HDPE"
	quest.59451B5DAD78C46F.quest_desc: [
		"El &bDesintegrador Atómico&r es la mejor herramienta que usarás. "
		""
		"Es todas las herramientas en una y puede infligir &4mucho daño&r."
	]
	quest.59451B5DAD78C46F.title: "Desintegrador Atómico"
	quest.5BDE55C11519F7F7.quest_desc: [
		"La &bCámara de Purificación&r te permite procesar diferentes &9minerales en bruto&r y &efragmentos&r en &caglomerados&r usando &7oxígeno&r. "
		""
		"Esta máquina es la primera etapa para el procesamiento de minerales al &a300%&r. "
	]
	quest.5BDE55C11519F7F7.title: "Cámara de Purificación"
	quest.5F95D00149FB24FD.quest_desc: ["La &bCámara de Disolución Química&r toma un &9mineral&r y &6disuelve&r químicamente todas las impurezas, resultando en una &dsuspensión de mineral sin procesar&r."]
	quest.5F95D00149FB24FD.title: "Cámara de Disolución Química"
	quest.5FFDA262D7693860.quest_desc: ["Crea &aPellets de Polonio&r reutilizando los &2desechos nucleares&r y combinándolos con &bpolvo de fluorita&r."]
	quest.5FFDA262D7693860.title: "Pellet de Polonio"
	quest.60F4F5FE0C3748C3.quest_desc: [
		"El &bLavador Químico&r se usa para limpiar &dsuspensiones&r y prepararlas para la &9cristalización&r. "
		""
		"La etapa final del procesamiento de minerales al &a500%&r."
	]
	quest.60F4F5FE0C3748C3.title: "Lavador Químico"
	quest.632BE5724D2120EB.quest_desc: [
		"La &bAleación Reforzada&r es un material élite hecho &6infundiendo&r diamante en la aleación infundida."
		""
		"Lo necesitarás para la siguiente etapa de máquinas."
	]
	quest.632BE5724D2120EB.title: "Aleación Reforzada"
	quest.6387004E98403CCE.quest_desc: ["El &bCristalizador Químico&r usa &dsuspensión de mineral purificada&r y la &9cristaliza&r en cristales."]
	quest.6387004E98403CCE.title: "Cristalizador Químico"
	quest.67D5ED5703F35A2D.quest_desc: [
		"El &bActivador de Neutrones Solares&r dirige la &cradiación de neutrones&r del &6sol&r a un depósito interno para crear ciertos &9isótopos&r."
		""
		"Puedes usar esta máquina para &6reutilizar&r &2desechos nucleares&r en &3isótopos radiactivos útiles&r."
	]
	quest.67D5ED5703F35A2D.title: "Activador de Neutrones Solares"
	quest.68C8CDDDD7EA8A48.quest_desc: ["Necesitarás un &bPuerto SPS&r para alimentar y recuperar recursos de tu &9Cambiador de Fase&r."]
	quest.68C8CDDDD7EA8A48.title: "Puerto SPS"
	quest.693C902E4E926BB4.quest_desc: ["El &bOxidador Químico&r puede tomar &3sólidos&r y &6oxidarlos&r a un &estado gaseoso&r."]
	quest.693C902E4E926BB4.title: "Oxidador Químico"
	quest.69B079DABB860AEF.quest_desc: ["Una &bplaca de circuito&r fortificada con &5obsidiana refinada&r; construida para soportar las cargas e impactos más intensos."]
	quest.69B079DABB860AEF.title: "Circuito de Control Definitivo"
	quest.6A382549A4C55A5E.quest_desc: ["El &cCircuito de Control Avanzado&r es el siguiente nivel de &6circuitos&r que te permitirá crear maquinaria aún más avanzada."]
	quest.6A382549A4C55A5E.title: "Circuito de Control Avanzado"
	quest.703C1F1E9A6F4A9E.quest_desc: ["El &bInfusor Químico&r te permite reaccionar &7dos gases&r en un &9producto singular&r."]
	quest.703C1F1E9A6F4A9E.title: "Infusor Químico"
	quest.71DD555551705B17.quest_desc: [
		"Uno de los primeros usos del &8acero&r es hacer un &bTanque Dinámico&r. "
		""
		"Es un &emultibloque&r usado para almacenar grandes cantidades de &7fluidos&r, incluyendo &egases&r."
		""
		"El tamaño mínimo del tanque que puedes construir es un cubo de &a3x3x3&r bloques y el tamaño máximo es &a18x18x18&r. "
		""
		"Cada bloque que compone el volumen total del multibloque añade &3350,000mb&r de &7almacenamiento líquido&r o &316,000,000mb&r de &ealmacenamiento de gas&r."
	]
	quest.71DD555551705B17.title: "Tanque Dinámico"
	quest.740B34D7D1AF3FF0.quest_desc: ["El &bTriturador&r es una máquina usada para &6triturar&r objetos y bloques en &7polvos&r y otros &9materiales&r."]
	quest.740B34D7D1AF3FF0.title: "Triturador"
	quest.79515634992D02A3.quest_desc: [
		"Puedes tomar el &bGas de Antimateria&r recién formado y solidificarlo en un &bPellet de Antimateria&r."
		" "
		"Esto se usa para hacer las &6mejoras &9y &9máquinas&r más poderosas imaginables."
	]
	quest.79515634992D02A3.title: "Antimateria"
	quest.7BB4CE27736F4C08.quest_desc: [
		"La parte final del tanque es la &bVálvula Dinámica&r. "
		""
		"Solo colócala en algún lugar del &emultibloque&r para poder &6interactuar&r con el contenido del tanque ya sea &abombeando hacia adentro&r o &cbombeando hacia afuera&r."
	]
	quest.7BB4CE27736F4C08.title: "Válvula Dinámica"
}
