{
	quest.1610E88D5231E670.quest_desc: ["O &bControlador de Evaporação Térmica&r é o cérebro das suas novas torres de evaporação. Essas torres são usadas para pegar um &7fluido&r e &6evaporar&r &7água&r dele para &9aumentar a concentração&r dos &3sólidos dissolvidos&r dentro dele. &6Verifique seu EMI&r para ver exatamente o que você pode obter disso. Você &otalvez&r precise fazer alguns..."]
	quest.1610E88D5231E670.title: "Controlador de Evaporação Térmica"
	quest.1A885E0BA312B916.quest_desc: ["O &bAquecedor Resistivo&r permite que você transforme &aenergia&r em calor. Você pode então &6inserir&r calor na torre via a &bVálvula de Evaporação Térmica&r para ajudar a &raumentar&r a temperatura da torre."]
	quest.1A885E0BA312B916.title: "Aquecedor Resistivo"
	quest.1DE9A85C2E5348D1.quest_desc: [
		"O &bControlador do Reator de Fusão&r é o coração do &bReator de Fusão&r. "
		""
		"Ele garantirá que seu reator funcione &asuavemente&r contanto que você forneça o &8combustível&r e &9resfriamento&r adequados."
	]
	quest.1DE9A85C2E5348D1.title: "Controlador do Reator de Fusão"
	quest.22A2121A25A010AB.quest_desc: ["Cada &bCélula de Indução Básica&r adicionada à sua matriz adiciona &e3.2 GFE&r de armazenamento de energia."]
	quest.22A2121A25A010AB.title: "Célula de Indução Básica"
	quest.2675A4EA019B383F.quest_desc: [
		"Você precisará fazer &bTurbinas&r para &7aproveitar o vapor&r que você estará produzindo e gerar &eeletricidade&r. "
		""
		"Crie a turbina central e a estrutura ao redor."
	]
	quest.2675A4EA019B383F.title: "Hora da Turbina"
	quest.272E31F15A39517B.quest_desc: [
		"O primeiro passo para o estágio final de &egeração de energia&r; &bEstruturas do Reator de Fusão&r. "
		""
		"Elas conterão a reação de fusão &4imensamente poderosa&r dentro de suas paredes."
	]
	quest.272E31F15A39517B.title: "Estrutura do Reator de Fusão"
	quest.2821236A1E8FEF73.quest_desc: [
		"A &bPorta do Reator de Fusão&r é uma passagem reforçada para o centro do &bReator de Fusão&r."
		""
		"Sem nada &6conectado&r a ela, ela é tão forte quanto a estrutura, mas com algo &6conectado&r ela fornece uma passagem protegida de &a1 via&r para dentro ou fora do núcleo."
	]
	quest.2821236A1E8FEF73.title: "Porta do Reator de Fusão"
	quest.2ADDD30536A7FF68.quest_desc: ["&bVidro do Reator&r é um &3material transparente super aprimorado&r que pode ser usado para as paredes centrais do &bReator de Fusão&r. Todo mundo gosta de &6ver&r cores bonitas (que podem ou não &4obliterar&r você)."]
	quest.2B3B96DDFE5D3ACA.quest_desc: ["Usando &bCarcaças da Caldeira&r você pode criar uma &bCaldeira Termoelétrica&r para &6gerar&r &7vapor&r extra a partir de &ccalor externo&r, incluindo &9Sódio Líquido Superaquecido&r de um &bReator de Fissão&r ativo."]
	quest.2B3B96DDFE5D3ACA.title: "Carcaça da Caldeira"
	quest.3689AAE9D0DB96FB.quest_desc: ["A &bVálvula de Evaporação Térmica&r é como você pode &6inserir&r e &6extrair&r seus &7fluidos&r da torre. Você precisará de pelo menos &9duas&r para entrada e saída. Você também pode &6usar&r uma válvula para inserir &ccalor&r de &bCondutores Termodinâmicos&r."]
	quest.3689AAE9D0DB96FB.title: "Válvula de Evaporação Térmica"
	quest.3C6E442CEB73191F.quest_desc: [
		"O &bGerador a Gás&r pode usar uma pletora de &cgases inflamáveis&r para gerar &eeletricidade&r. "
		""
		"Gases como &7Hidrogênio&r e &dEtileno&r podem ser bons para uma grande quantidade de &eenergia&r logo no início. "
		""
		"Verifique seu &dEMI&r para ver quais &7gases&r são verdadeiramente &cinflamáveis&r e quanta &6energia&r você pode gerar com eles."
	]
	quest.3C6E442CEB73191F.title: "Gerador a Gás"
	quest.3D5B74D9663AAB5A.quest_desc: [
		"O &bGerador de Calor&r é uma fonte simples de energia que depende de &cfontes de calor&r cercando-o. "
		""
		"O &bGerador&r pode receber &ccalor&r de &a7&r locais, &a6&r dos quais são suas diferentes faces. Outro é o próprio gerador que pode estar &4imerso em lava&r. Ele não &6gera&r muita energia, mas para o começo da sua jornada, é o suficiente!"
		""
		"Não apenas &bblocos&r e &7fluidos&r emissores de &ccalor&r gerarão energia, mas calor de &bCondutores Termodinâmicos&r também."
	]
	quest.3D5B74D9663AAB5A.title: "Gerador de Calor"
	quest.400274581B9BD5FC.quest_desc: ["A &bMatriz de Foco a Laser&r é usada para acender seu &bReator de Fusão&r focando o feixe de um &claser&r diretamente no núcleo do reator."]
	quest.436C9C6FF59C4FD5.quest_desc: ["Cada &bProvedor de Indução Básico&r adicionado à sua matriz adiciona &e102.4 kFE por tick&r de taxa de transferência de energia, dentro e fora de sua matriz."]
	quest.436C9C6FF59C4FD5.title: "Provedor de Indução Básico"
	quest.4EA0C90A02A43131.quest_desc: [
		"A &bCâmara de Reação Pressurizada&r pega &3sólidos&r, &7líquidos&r, e &egases&r para produzir outros &3sólidos&r e &egases&r em um ambiente pressurizado."
		""
		"&6Verifique&r seu EMI para ver para o que você pode usá-la especificamente."
	]
	quest.4EA0C90A02A43131.title: "Câmara de Reação Pressurizada"
	quest.4FBA0ECAC8AEBCD8.quest_desc: [
		"A &bMontagem de Combustível de Fissão&r é um aglomerado de hastes que seguram o &dcombustível físsil&r. "
		""
		"Coloque-as umas sobre as outras diretamente sob as &bMontagens de Haste de Controle&r."
	]
	quest.4FBA0ECAC8AEBCD8.title: "Fissão Nuclear"
	quest.50D1398BBF8DBBB2.quest_desc: ["O &bSeparador Eletrolítico&r permite que você pegue múltiplos &7fluidos&r e &6separe&r eles em seus componentes elementares centrais usando &eeletricidade&r para quebrar as moléculas em um processo chamado \"&6Eletrólise&r\""]
	quest.50D1398BBF8DBBB2.title: "Separador Eletrolítico"
	quest.52AD3D58B644AA30.quest_desc: [
		"O &bGerador Eólico&r produz &eenergia&r usando o &7vento&r! "
		""
		"É um \"&acolocar e usar&r\" significando que não há necessidade de interação humana."
	]
	quest.52AD3D58B644AA30.title: "Gerador Eólico"
	quest.5AB4D1D72EFD4428.quest_desc: ["A &bPorta de Indução&r permitirá que você faça interface com sua &9Matriz de Indução&r. "]
	quest.5AB4D1D72EFD4428.title: "Porta de Indução"
	quest.60AEE273431548B6.quest_desc: ["Coloque um &bDispersor de Pressão&r através de uma turbina e caldeira para regular adequadamente o &7escape de pressão&r."]
	quest.60AEE273431548B6.title: "Dispersor de Pressão"
	quest.7610F9A545A15194.quest_desc: [
		"O &bGerador Solar&r usa o &6sol&r para gerar &eenergia&r. "
		""
		"Obviamente, quando o &6sol&r está baixo, nenhuma &eenergia&r é gerada. "
	]
	quest.7610F9A545A15194.title: "Gerador Solar"
	quest.7921D6460E480F82.quest_desc: [
		"Use uma &bVálvula da Caldeira&r para &cinserir calor&r e &9água&r. "
		""
		"Também para &aextrair&r &7vapor&r."
	]
	quest.7921D6460E480F82.title: "Válvula da Caldeira"
	quest.7BEA5B1D1B410E82.quest.desc: ["O &3Gerador Solar Avançado&r é uma versão melhorada do pequeno &3Gerador Solar&r e fornece muito mais &aenergia&r. Você pode &6colocá-los&r nos cantos superiores da &3Torre de Evaporação Térmica&r com a &asaída de energia&r verde voltada para o &3Bloco de Evaporação Térmica&r para &6aumentar&r o &ccalor&r da torre durante o dia."]
	quest.7BEA5B1D1B410E82.quest_desc: [
		"O &bGerador Solar Avançado&r é uma versão melhorada do pequeno &3Gerador Solar&r e fornece muito mais &aenergia&r. "
		""
		"Você pode &6colocá-los&r nos cantos superiores da &bTorre de Evaporação Térmica&r com a &asaída de energia&r verde voltada para o &bBloco de Evaporação Térmica&r para &6aumentar&r o &ccalor&r da torre durante o dia."
	]
	quest.7BEA5B1D1B410E82.title: "Gerador Solar Avançado"
	quest.7FC6AE9DB7C1DA52.quest_desc: [
		"O &bBio-Gerador&r pega &2biocombustível&r para gerar &eenergia&r. "
		""
		"Você pode fazer &2biocombustível&r &6triturando&r quase qualquer &bmaterial orgânico&r."
