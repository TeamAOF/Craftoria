	]
	quest.632BE5724D2120EB.title: "Liga Reforçada"
	quest.6387004E98403CCE.quest_desc: ["O &bCristalizador Químico&r usa &dpolpa de minério purificada&r e a &9cristaliza&r em cristais."]
	quest.6387004E98403CCE.title: "Cristalizador Químico"
	quest.67D5ED5703F35A2D.quest_desc: [
		"O &bAtivador de Nêutrons Solar&r direciona &cradiação de nêutrons&r do &6sol&r para um reservatório interno para criar certos &9isótopos&r. "
		""
