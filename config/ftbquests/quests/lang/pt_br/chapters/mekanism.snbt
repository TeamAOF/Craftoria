	quest.59451B5DAD78C46F.title: "Desmontador Atômico"
	quest.5BDE55C11519F7F7.quest_desc: [
		"A &bCâmara de Purificação&r permite que você processe diferentes &9minérios brutos&r e &efragmentos&r em &caglomerados&r usando &7oxigênio&r. "
		""
		"Esta máquina é o primeiro estágio para o processamento de minério de &a300%&r. "
	]
	quest.5BDE55C11519F7F7.title: "Câmara de Purificação"
	quest.5F95D00149FB24FD.quest_desc: ["A &bCâmara de Dissolução Química&r pega um &9minério&r e quimicamente &6dissolve&r todas as impurezas resultando em uma &dpolpa de minério&r não processada."]
	quest.5F95D00149FB24FD.title: "Câmara de Dissolução Química"
	quest.5FFDA262D7693860.quest_desc: ["Crie &aPelotas de Polônio&r reaproveitando o &2resíduo nuclear&r e combinando-o com &bpó de fluorita&r."]
	quest.5FFDA262D7693860.title: "Pelota de Polônio"
	quest.60F4F5FE0C3748C3.quest_desc: [
		"O &bLavador Químico&r é usado para limpar &dpolpas&r e prepará-las para &9cristalização&r. "
		""
		"O estágio final do processamento de minério de &a500%&r."
	]
	quest.60F4F5FE0C3748C3.title: "Lavador Químico"
	quest.632BE5724D2120EB.quest_desc: [
