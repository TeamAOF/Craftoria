	quest.566D039774A4DB9D.title: "Pelota de Plutônio"
	quest.56C5ECD3430B6A55.quest_desc: ["Os &bÉlitros Reforçados de HDPE&r são uma melhoria direta aos &délitros&r regulares. Este ostenta o dobro da durabilidade e a habilidade de repará-lo com &7Folhas de HDPE&r, reparando &3um quarto&r da durabilidade para cada!"]
	quest.56C5ECD3430B6A55.title: "Élitros Reforçados de HDPE"
	quest.59451B5DAD78C46F.quest_desc: [
