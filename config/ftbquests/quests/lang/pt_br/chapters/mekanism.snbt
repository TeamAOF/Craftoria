	]
	quest.67D5ED5703F35A2D.title: "Ativador de Nêutrons Solar"
	quest.68C8CDDDD7EA8A48.quest_desc: ["Você precisará de uma &bPorta AFS&r para alimentar e recuperar recursos do seu &9Deslocador de Fase&r."]
	quest.68C8CDDDD7EA8A48.title: "Porta AFS"
